# Caddyfile for Railway Single-Port Routing
:{$PORT} {
	handle_path /api/proxy/9080* {
		reverse_proxy localhost:9080
	}
	handle_path /api/proxy/9081* {
		reverse_proxy localhost:9081
	}
	handle_path /api/proxy/9082* {
		reverse_proxy localhost:9082
	}
	handle_path /api/proxy/9083* {
		reverse_proxy localhost:9083
	}
	handle {
		reverse_proxy localhost:3000
	}
}
